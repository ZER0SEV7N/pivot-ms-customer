  <diagram id="xJpw9UP7UM6cSxNcEu7D" name="Class Diagram">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Customer {\n        &lt;&lt;Java Class&gt;&gt;\n        -String id\n        -String documentNumber\n        -String email\n        -String phoneNumber\n        -String address\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +Customer()\n        +getId() String\n        +getDocumentNumber() String\n        +setDocumentNumber(String) void\n        +getEmail() String\n        +setEmail(String) void\n        +validateCustomerRules() boolean\n    }\n\n    class PersonalCustomer {\n        &lt;&lt;Java Class&gt;&gt;\n        -String firstName\n        -String lastName\n        +PersonalCustomer()\n        +getFirstName() String\n        +setFirstName(String) void\n        +getLastName() String\n        +setLastName(String) void\n    }\n\n    class BusinessCustomer {\n        &lt;&lt;Java Class&gt;&gt;\n        -String businessName\n        +BusinessCustomer()\n        +getBusinessName() String\n        +setBusinessName(String) void\n    }\n\n    class CustomerType {\n        &lt;&lt;enumeration&gt;&gt;\n        PERSONAL\n        BUSINESS\n    }\n\n    class CustomerProfile {\n        &lt;&lt;enumeration&gt;&gt;\n        STANDARD\n        VIP\n        PYME\n    }\n\n    class DocumentType {\n        &lt;&lt;enumeration&gt;&gt;\n        DNI\n        CE\n        PASSPORT\n        RUC\n    }\n\n    class CustomerStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        ACTIVE\n        INACTIVE\n        BLOCKED\n    }\n\n    %% Herencia (Generalización UML como en tu Imagen 1 y 2)\n    Customer &lt;|-- PersonalCustomer\n    Customer &lt;|-- BusinessCustomer\n\n    %% Asociaciones con Multiplicidad (como en tu Imagen 1 y 3)\n    Customer \&quot;0..*\&quot; --&gt; \&quot;1\&quot; CustomerType : classified as\n    Customer \&quot;0..*\&quot; --&gt; \&quot;1\&quot; CustomerProfile : has profile\n    Customer \&quot;0..*\&quot; --&gt; \&quot;1\&quot; DocumentType : identified by\n    Customer \&quot;0..*\&quot; --&gt; \&quot;1\&quot; CustomerStatus : has state&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="6TR6TwiFr9RIvzCpRU4W-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidId="e:Customer-&gt;BusinessCustomer#0" mermaidBaseStyle="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;startArrow=block;startSize=8;startFill=0;endArrow=none;jumpStyle=arc;jumpSize=12;strokeColor=#000000;exitX=0.3;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;sourcePerimeterSpacing=9.25;" mermaidBaseValue="" id="6TR6TwiFr9RIvzCpRU4W-61">
          <mxCell edge="1" parent="6TR6TwiFr9RIvzCpRU4W-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;startArrow=block;startSize=8;startFill=0;endArrow=none;jumpStyle=arc;jumpSize=12;strokeColor=#000000;exitX=0.3;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;sourcePerimeterSpacing=9.25;">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="669" y="478" />
