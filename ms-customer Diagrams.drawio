        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;stateDiagram-v2\n    [*] --&gt; Requested : submitRegistration()\n\n    state \&quot;Validating Customer (Strategy &amp; Uniqueness)\&quot; as Validating {\n        [*] --&gt; CheckingRules\n        CheckingRules : Rules &amp; Document Checked\n        \n        state check_choice &lt;&lt;choice&gt;&gt;\n        CheckingRules --&gt; check_choice : evaluateStrategy()\n        \n        check_choice --&gt; ValidationPassed : [valid rules &amp; unique document]\n        check_choice --&gt; ValidationFailed : [invalid type/RUC or duplicate doc]\n        \n        ValidationPassed --&gt; [*]\n    }\n\n    Requested --&gt; Validating : processRegistration\n    Validating --&gt; Rejected : [validation failed]\n    Rejected --&gt; [*]\n\n    Validating --&gt; Active : approveRegistration [Customer persisted]\n\n    Active --&gt; Upgraded : upgradeProfile [has Credit Card &amp; meets balance]\n    Upgraded : Active (VIP / PYME Profile)\n\n    Active --&gt; Suspended : suspendAccount [compliance or fraud alert]\n    Upgraded --&gt; Suspended : suspendAccount [compliance or fraud alert]\n    Suspended --&gt; Active : reactivate [audit cleared]\n\n    Active --&gt; Closed : deleteCustomer [no active accounts or debt]\n    Upgraded --&gt; Closed : deleteCustomer [no active accounts or debt]\n    Closed --&gt; [*]&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="yHO3xLCIETmy98o1JYgF-14">
