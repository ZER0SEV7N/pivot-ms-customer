  <diagram id="1EM7E4_l8QQ7pDxCCBvI" name="Architecture Class Diagram">
    <mxGraphModel dx="2575" dy="1565" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    namespace Infrastructure_In_Web {\n        class CustomerController {\n            -CreateCustomerUseCase createCustomerUseCase\n            -RetrieveCustomerUseCase retrieveCustomerUseCase\n            -UpdateCustomerUseCase updateCustomerUseCase\n            -DeleteCustomerUseCase deleteCustomerUseCase\n            -CustomerWebMapper mapper\n            +createCustomer(Single~CustomerRequest~) Single~ResponseEntity~\n            +getAllCustomers() Flowable~CustomerResponse~\n            +getCustomerById(String id) Single~ResponseEntity~\n            +getCustomerByDocument(String docNumber) Single~ResponseEntity~\n            +updateCustomer(String id, Single~CustomerRequest~) Single~ResponseEntity~\n            +deleteCustomer(String id) Completable\n        }\n    }\n\n    namespace Domain_Ports_In {\n        class CreateCustomerUseCase {\n            &lt;&lt;interface&gt;&gt;\n            +execute(Customer customer) Single~Customer~\n        }\n        class RetrieveCustomerUseCase {\n            &lt;&lt;interface&gt;&gt;\n            +findAll() Flowable~Customer~\n            +findById(String id) Maybe~Customer~\n            +findByDocumentNumber(String documentNumber) Maybe~Customer~\n        }\n        class UpdateCustomerUseCase {\n            &lt;&lt;interface&gt;&gt;\n            +execute(String id, Customer customer) Single~Customer~\n        }\n        class DeleteCustomerUseCase {\n            &lt;&lt;interface&gt;&gt;\n            +execute(String id) Completable\n        }\n    }\n\n    namespace Application_UseCases {\n        class CustomerUseCaseImpl {\n            -CustomerRepositoryPort repositoryPort\n            -List~CustomerValidationStrategy~ strategies\n            +execute(Customer customer) Single~Customer~\n            +findAll() Flowable~Customer~\n            +findById(String id) Maybe~Customer~\n            +findByDocumentNumber(String documentNumber) Maybe~Customer~\n            +execute(String id, Customer customer) Single~Customer~\n            +execute(String id) Completable\n        }\n    }\n\n    namespace Domain_Strategy {\n        class CustomerValidationStrategy {\n            &lt;&lt;interface&gt;&gt;\n            +supports(CustomerType type) boolean\n            +validate(Customer customer) Completable\n        }\n        class PersonalCustomerStrategy {\n            +supports(CustomerType type) boolean\n            +validate(Customer customer) Completable\n        }\n        class BusinessCustomerStrategy {\n            +supports(CustomerType type) boolean\n            +validate(Customer customer) Completable\n        }\n    }\n\n    namespace Domain_Model {\n        class Customer {\n            -String id\n            -CustomerType customerType\n            -CustomerProfile profile\n            -DocumentType documentType\n            -String documentNumber\n            -String firstName\n            -String lastName\n            -String businessName\n            -String email\n            -String phoneNumber\n            -String address\n            -CustomerStatus status\n            -LocalDateTime createdAt\n            -LocalDateTime updatedAt\n        }\n    }\n\n    namespace Domain_Ports_Out {\n        class CustomerRepositoryPort {\n            &lt;&lt;interface&gt;&gt;\n            +save(Customer customer) Single~Customer~\n            +findAll() Flowable~Customer~\n            +findById(String id) Maybe~Customer~\n            +findByDocumentNumber(String docNumber) Maybe~Customer~\n            +existsByDocumentNumber(String docNumber) Single~Boolean~\n            +deleteById(String id) Completable\n        }\n    }\n\n    namespace Infrastructure_Out_Persistence {\n        class CustomerPersistenceAdapter {\n            -ReactiveCustomerMongoRepository mongoRepository\n            -CustomerPersistenceMapper mapper\n            +save(Customer customer) Single~Customer~\n            +findAll() Flowable~Customer~\n            +findById(String id) Maybe~Customer~\n            +findByDocumentNumber(String docNumber) Maybe~Customer~\n            +existsByDocumentNumber(String docNumber) Single~Boolean~\n            +deleteById(String id) Completable\n        }\n        class CustomerDocument {\n            &lt;&lt;@Document(\&quot;customers\&quot;)&gt;&gt;\n            -String id\n            -String customerType\n            -String profile\n            -String documentType\n            -String documentNumber\n        }\n    }\n\n    CustomerController --&gt; CreateCustomerUseCase\n    CustomerController --&gt; RetrieveCustomerUseCase\n    CustomerController --&gt; UpdateCustomerUseCase\n    CustomerController --&gt; DeleteCustomerUseCase\n\n    CustomerUseCaseImpl ..|&gt; CreateCustomerUseCase\n    CustomerUseCaseImpl ..|&gt; RetrieveCustomerUseCase\n    CustomerUseCaseImpl ..|&gt; UpdateCustomerUseCase\n    CustomerUseCaseImpl ..|&gt; DeleteCustomerUseCase\n    CustomerUseCaseImpl --&gt; CustomerRepositoryPort\n    CustomerUseCaseImpl --&gt; CustomerValidationStrategy\n    CustomerUseCaseImpl --&gt; Customer\n\n    PersonalCustomerStrategy ..|&gt; CustomerValidationStrategy\n    BusinessCustomerStrategy ..|&gt; CustomerValidationStrategy\n\n    CustomerPersistenceAdapter ..|&gt; CustomerRepositoryPort\n    CustomerPersistenceAdapter --&gt; CustomerDocument&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="CHDWMqUBuwOA0wrkOqPM-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
