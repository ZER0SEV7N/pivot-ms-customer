  "item": [
    {
      "name": "1. Create Personal Customer (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"customerId\", jsonData.id);",
              "    pm.collectionVariables.set(\"personalDocNumber\", jsonData.documentNumber);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerType\": \"PERSONAL\",\n  \"profile\": \"STANDARD\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"71234567\",\n  \"firstName\": \"Daniel\",\n  \"lastName\": \"Singer\",\n  \"email\": \"daniel.singer@pivotbank.pe\",\n  \"phoneNumber\": \"+51987654321\",\n  \"address\": \"Av. Javier Prado Este 456, Lima\"\n}"
